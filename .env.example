# Supabase (Project Settings > API)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...      # geheim: alleen in Vercel, nooit in de browser

# Volledig adres van de site, zonder / op het einde
SITE_URL=https://vbha-beheer.vercel.app

# Enable Banking (Control Panel > API applications)
ENABLE_BANKING_APP_ID=aaaaaaaa-bbbb-cccc-dddd-eeeeeeeeeeee
ENABLE_BANKING_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# Willekeurige lange tekst; Vercel stuurt die mee bij de dagelijkse synchronisatie
CRON_SECRET=verander-mij-in-een-lange-willekeurige-tekst

# Bancontact Pay (vroeger Payconiq): online betalen van het lidgeld op het inschrijfformulier
# Online betalen met Mollie (aanbevolen). Met MOLLIE_API_KEY ingevuld wordt Mollie gebruikt.
MOLLIE_API_KEY=
# MOLLIE_METHODS=bancontact   # of bv. bancontact,kbc,belfius,creditcard
# Of: Bancontact Pay (vroeger Payconiq)
BANCONTACT_API_KEY=
# BANCONTACT_ENV=ext   # alleen om te testen in de testomgeving van Bancontact
