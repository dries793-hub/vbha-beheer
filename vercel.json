{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "public",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; media-src 'self' blob: https:; connect-src 'self' https://xjfnwnedujcdfjfchigc.supabase.co wss://xjfnwnedujcdfjfchigc.supabase.co; frame-src 'self' blob: data:; worker-src 'self' blob:; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(self), payment=(), usb=(), interest-cohort=()"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin-allow-popups"
        }
      ]
    }
  ],
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/banket",
      "destination": "/api/openbaar?f=banket"
    },
    {
      "source": "/api/kinderfeest",
      "destination": "/api/openbaar?f=kinderfeest"
    },
    {
      "source": "/api/ronde",
      "destination": "/api/openbaar?f=ronde"
    },
    {
      "source": "/api/leden",
      "destination": "/api/openbaar?f=leden"
    },
    {
      "source": "/api/gebruikers",
      "destination": "/api/config?f=gebruikers"
    },
    {
      "source": "/api/sponsor",
      "destination": "/api/openbaar?f=sponsor"
    },
    {
      "source": "/api/status",
      "destination": "/api/openbaar?f=status"
    },
    {
      "source": "/api/reglement",
      "destination": "/api/openbaar?f=reglement"
    },
    {
      "source": "/api/deel",
      "destination": "/api/openbaar?f=deel"
    },
    {
      "source": "/api/adres",
      "destination": "/api/openbaar?f=adres"
    },
    {
      "source": "/api/kalender",
      "destination": "/api/openbaar?f=kalender"
    }
  ]
}
